{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@synapse/types": ["../../packages/types/src"],
      "@synapse/api": ["../../packages/api/src"],
      "@synapse/auth": ["../../packages/auth/src"],
      "@synapse/database": ["../../packages/database/src"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
