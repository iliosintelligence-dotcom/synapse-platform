{
  "expo": {
    "name": "Synapse",
    "slug": "synapse",
    "version": "0.1.0",
    "scheme": "synapse",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.synapse.app"
    },
    "android": {
      "package": "ng.synapse.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
