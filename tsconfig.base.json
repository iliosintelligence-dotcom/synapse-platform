{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022"],
    "baseUrl": ".",
    "paths": {
      "@synapse/types": ["packages/types/src"],
      "@synapse/types/*": ["packages/types/src/*"],
      "@synapse/api": ["packages/api/src"],
      "@synapse/api/*": ["packages/api/src/*"],
      "@synapse/auth": ["packages/auth/src"],
      "@synapse/auth/*": ["packages/auth/src/*"],
      "@synapse/ui": ["packages/ui/src"],
      "@synapse/ui/*": ["packages/ui/src/*"],
      "@synapse/database": ["packages/database/src"],
      "@synapse/database/*": ["packages/database/src/*"]
    }
  }
}
