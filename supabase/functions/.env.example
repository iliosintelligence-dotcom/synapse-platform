# Secrets for Synapse Edge Functions.
# Set with: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform — do NOT set them here.

# toju-chat
OPENAI_API_KEY=sk-...

# create-lead (the lead bridge)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or your number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
